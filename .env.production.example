# ==============================================================================
# MTPL Travel Platform — Production Environment Template (Hostinger VPS KVM 1)
# ==============================================================================
# Copy to .env.production on the VPS and replace ALL placeholder values.
# NEVER commit .env.production to Git. Restrict file permissions: chmod 600 .env.production
#
# Run Compose on VPS with:
#   docker compose --env-file .env.production -f docker-compose.prod.yml pull
#   docker compose --env-file .env.production -f docker-compose.prod.yml up -d --no-build
# ==============================================================================

# ------------------------------------------------------------------------------
# Published Production Container Image (Built outside VPS & pushed to registry)
# ------------------------------------------------------------------------------
# Pre-build on CI runner or build machine and push to GitHub Container Registry (ghcr.io)
# Format: ghcr.io/<org-or-user>/mtpl-travel-platform:<release-tag-or-commit-sha>
# NOTE: If package is private, authenticate via 'docker login ghcr.io' before pulling.
MTPL_IMAGE=ghcr.io/navkar-logic/mtpl-travel-platform:<RELEASE_TAG_OR_COMMIT_SHA>

# ------------------------------------------------------------------------------
# Application Runtime & Canonical Domain
# ------------------------------------------------------------------------------
NODE_ENV=production
NEXT_PUBLIC_ENVIRONMENT=production
NEXT_PUBLIC_APP_NAME=MTPL

# Preferred canonical URL shared across metadata, policy canonicals, and emails.
# Both mishrikotkartravels.com and mtpl.online serve HTTP 200 without redirects.
NEXT_PUBLIC_SITE_URL=https://mishrikotkartravels.com
NEXT_PUBLIC_APP_URL=https://mishrikotkartravels.com

# ------------------------------------------------------------------------------
# MongoDB 8 (Private Docker Network: mongodb:27017)
# ------------------------------------------------------------------------------
# The Next.js application connects using a dedicated, non-root user restricted to mtpl_production.
# URL-encode special characters in password inside MONGODB_URI (or use alphanumeric/underscore).
MONGODB_URI=mongodb://mtpl_app:<REPLACE_WITH_STRONG_APP_PASSWORD>@mongodb:27017/mtpl_production?authSource=mtpl_production

# Dedicated non-root application credentials (created automatically during initial mongo bootstrap)
MONGO_APP_USER=mtpl_app
MONGO_APP_PASSWORD=<REPLACE_WITH_STRONG_APP_PASSWORD>

# MongoDB root credentials (retained exclusively for database administration, backups, and restores)
MONGO_ROOT_USER=mtpl_prod_admin
MONGO_ROOT_PASSWORD=<REPLACE_WITH_STRONG_ROOT_PASSWORD>
MONGO_DATABASE=mtpl_production

# Cap WiredTiger RAM cache for 4 GB RAM VPS (Hostinger KVM 1)
MONGO_WT_CACHE_GB=0.5

# ------------------------------------------------------------------------------
# Persistent Media Storage (Host-mounted at /srv/mtpl/media)
# ------------------------------------------------------------------------------
MEDIA_STORAGE_PROVIDER=local
MEDIA_STORAGE_ROOT=/srv/mtpl/media
MEDIA_MAX_IMAGE_SIZE_MB=10
MEDIA_MAX_PDF_SIZE_MB=20

# ------------------------------------------------------------------------------
# Google Workspace Business Email & SMTP Configuration (Nodemailer)
# ------------------------------------------------------------------------------
# The platform dispatches transactional emails via Google Workspace for
# mishrikotkartravels.com. Two configuration methods are supported:
#
# Method 1: Standard SMTP (smtp.gmail.com)
#   - Requires 2-Step Verification active on the sending Workspace mailbox.
#   - Requires an App Password ONLY IF permitted by the Workspace organization/admin policy.
#     (IMPORTANT: App Passwords are NOT universally available; Google Workspace
#      administrators can restrict or disable App Password generation via security policies).
#   - Connection: Port 465 (implicit TLS, SMTP_SECURE=true) OR Port 587 (STARTTLS, SMTP_SECURE=false).
#   - SMTP_PASS: 16-character Google App Password (not the user login password).
#
# Method 2: Google Workspace SMTP Relay (smtp-relay.gmail.com)
#   - Requires Google Workspace administrator setup in Google Admin Console:
#     Apps > Google Workspace > Gmail > Routing > SMTP relay service.
#   - Allows IP-based allowlisting (VPS public IP) and/or SMTP authentication.
#   - Connection: Port 465 (implicit TLS, SMTP_SECURE=true) OR Port 587 (STARTTLS, SMTP_SECURE=false).
#   - Useful when App Passwords cannot be created due to organization-level 2SV/credential policies.
#
# Notes:
#   - SMTP_USER must be the authentic sending Google Workspace mailbox.
#   - Ensure DNS records on mishrikotkartravels.com include Google SPF
#     ("v=spf1 include:_spf.google.com ~all"), DKIM (Google Admin generated), and DMARC.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=support@mishrikotkartravels.com
SMTP_PASS=<REPLACE_WITH_WORKSPACE_APP_PASSWORD_OR_RELAY_CREDENTIALS>

SMTP_FROM_NAME="Mishrikotkar Travels Pvt. Ltd. (MTPL)"
SMTP_FROM_EMAIL=support@mishrikotkartravels.com
ENQUIRY_NOTIFICATION_EMAIL=support@mishrikotkartravels.com

# ------------------------------------------------------------------------------
# Customer Support Contacts
# ------------------------------------------------------------------------------
SUPPORT_PHONE=+917741006600
SUPPORT_WHATSAPP=918381006600

# ------------------------------------------------------------------------------
# Off-Server Backup Destination (Used by deploy/scripts/backup-mtpl.sh)
# ------------------------------------------------------------------------------
# Example rclone remote (e.g. s3:mtpl-prod-backups or b2:mtpl-prod-backups)
# Leave empty until off-server rclone remote is configured on the VPS.
BACKUP_REMOTE_DEST=

# ------------------------------------------------------------------------------
# Phase 2 Future Placeholders (Inactive in Phase 1 — Reserved for Admin CMS)
# ------------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET=<RESERVED_FOR_PHASE_2_DO_NOT_REUSE_DB_PASSWORD>

