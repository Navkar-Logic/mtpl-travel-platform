# ==========================================
# MTPL Travel Platform — Environment Variables
# ==========================================

# Application Environment
# Options: development | staging | production
NEXT_PUBLIC_ENVIRONMENT=development

# Node environment (Should be 'production' in both staging and prod deployments)
NODE_ENV=development

NEXT_PUBLIC_APP_NAME=MTPL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------
# Database Configuration (Authoritative: MongoDB)
# ------------------------------------------
# Local host machine connecting to Docker container:
MONGODB_URI=mongodb://<db_username>:<db_password>@127.0.0.1:27017/mtpl_dev?authSource=admin

# Container-to-container inside Docker network (uncomment if running app inside Docker):
# MONGODB_URI=mongodb://<db_username>:<db_password>@mongodb:27017/mtpl_dev?authSource=admin

# Production deployment (MUST use strong credentials, isolated network, and admin auth source):
# MONGODB_URI=mongodb://<production_user>:<production_password>@127.0.0.1:27017/mtpl_production?authSource=admin

# Docker Compose root initialization credentials:
MONGO_ROOT_USER=mtpl_admin
MONGO_ROOT_PASSWORD=your_secure_development_password_here
MONGO_DATABASE=mtpl_dev

# ------------------------------------------
# Media Storage Configuration
# ------------------------------------------
# Local filesystem provider (stores in ./storage/media)
MEDIA_STORAGE_PROVIDER=local
MEDIA_STORAGE_ROOT=./storage/media
MEDIA_MAX_IMAGE_SIZE_MB=10
MEDIA_MAX_PDF_SIZE_MB=20

# Production persistent path (must be outside ephemeral build dir, e.g. /srv/mtpl/media):
# MEDIA_STORAGE_ROOT=/srv/mtpl/media

# ------------------------------------------
# Email & SMTP Configuration (Nodemailer)
# ------------------------------------------
# SMTP Provider Settings (Hostinger / Google Workspace / Dedicated Mail Server)
# NOTE: Verify domain authentication (SPF, DKIM, DMARC) and mailbox existence before enabling.
# Note on domain naming: Intended email domain is 'mishrikotkartravels.com' matching corporate identity.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=support@mishrikotkartravels.com
SMTP_PASS=your_smtp_mailbox_password_here

# Outgoing & Notification Email Identities
SMTP_FROM_NAME="Mishrikotkar Travels (MTPL)"
SMTP_FROM_EMAIL=support@mishrikotkartravels.com
ENQUIRY_NOTIFICATION_EMAIL=support@mishrikotkartravels.com

# Support & Direct Action Contacts (Used in Customer Confirmation & Internal Alerts)
SUPPORT_PHONE=+917741006600
SUPPORT_WHATSAPP=918381006600